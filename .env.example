PORT=3000
HTTPS_PORT=443
HTTP_PORT=80
NODE_ENV=development

# Supabase
SUPABASE_URL=your_project_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth
JWT_TOKEN=your_jwt_secret
SYSTEM_RECOVERY_KEY=your_random_secret_for_emergency_ip_unblock

# Encryption (required — generate a 32-byte key encoded as base64)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your_base64_32_byte_key
ENCRYPTION_KEY_VERSION=v1
ENCRYPTION_KEY_SOURCE=env
ENCRYPTION_KEY_ENV_NAME=ENCRYPTION_KEY

# Email (Gmail)
GMAIL_USER=your_gmail_address
GMAIL_APP_PASSWORD=your_gmail_app_password

# AI / Vector DB
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.0
GROQ_TOP_P=1.0
CHROMA_API_KEY=your_chroma_api_key
CHROMA_MODE=cloud
CHROMA_TENANT=your_chroma_tenant
CHROMA_DATABASE=your_chroma_database
RAG_COLLECTION=aus_food_nutrition
RAG_N_RESULTS=5
RAG_DISTANCE_THRESHOLD=0.8
RAG_RELAXED_DISTANCE_THRESHOLD=1.6

# MCP OAuth AS (35/42; 39/40 for issuance+JWKS). Mount only when "true" —
# after mig 002 + ticket 45 rate limits (~1.1 req/s shared egress otherwise).
OAUTH_ROUTES_ENABLED=false
# Exact absolute introspect URL (Q16a aud). Must match MCP byte-for-byte; never from Host.
MCP_INTROSPECTION_URL=https://your-backend-host/api/oauth/introspect
MCP_AS_ISSUER=https://your-backend-host
# Resource aud on MCP access tokens (/mcp path); must not equal MCP client_id.
MCP_RESOURCE_IDENTIFIER=https://your-mcp-host/mcp
# Ticket 40 placeholder (asVerificationKeys.js). Escaped \n expanded. Set KEY_ID with PEM or neither.
MCP_AS_PUBLIC_KEY_PEM=
MCP_AS_KEY_ID=
# Ticket 43: exact frontend Origin (literal; never *.vercel.app). Unset = refuse.
OAUTH_FRONTEND_ORIGIN=https://gonutrihelp.vercel.app
# Ticket 36: path on OAUTH_FRONTEND_ORIGIN the authorize endpoint sends the browser to.
# Same-origin path only — leading '/', no '//', no query, no fragment, or the request 503s.
# The redirect must carry the opaque transaction reference and nothing else.
OAUTH_FRONTEND_LOGIN_PATH=/login
# Q16a token-endpoint aud. Separate from MCP_INTROSPECTION_URL (no fallback). Unset = 503.
MCP_TOKEN_ENDPOINT_URL=https://your-backend-host/api/oauth/token
# Exchanged-credential aud (this API). Not MCP_RESOURCE_IDENTIFIER. Unset = 503.
MCP_BACKEND_API_AUDIENCE=https://your-backend-host/api
# Private half of MCP_AS_PUBLIC_KEY_PEM (same pair; mismatch refuses). RSA / RS256. Escaped \n.
MCP_AS_PRIVATE_KEY_PEM=

# Logging
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d
